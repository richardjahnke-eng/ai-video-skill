#!/bin/sh
# Entry point. preflight is silent once this machine has passed.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
"$ROOT/scripts/preflight"
# Same order as preflight's find_python, which may have accepted plain python.
PY=$(command -v python3 || command -v python)
ANALYZE_VIDEO_PREFLIGHT=done exec "$PY" "$ROOT/scripts/analyze_video.py" "$@"
